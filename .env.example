# Paths for a local rerun of the published pawn-bench harness.
# Leave these empty in git. Do not put secrets in this file.
#
# These scripts do not automatically load this file just because it exists.
# Export the variables in your shell, or run:  set -a; . .env; set +a

# Frozen Nextimus checkout used by run.sh (must be a git work tree).
NEXTIMUS_PAWN=

# Canonical source-art directory for T9–T16 and for kit_check.py.
# KIT_SOURCES is accepted as a fallback alias if QUATERNIUS_SOURCE is unset.
QUATERNIUS_SOURCE=
# KIT_SOURCES=

# Optional directory for preview or scene output.
PAWN_LOGS=
